<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Sunny Widgets" android:textSize="26sp" android:textStyle="bold" android:textColor="#FFB347" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="Transparent Spotify widget with a live wave + inverted text" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:text="Setup, in order" android:textSize="18sp" android:textColor="#FFD08A" />

    <Button android:id="@+id/btnNotif" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="1. Notification access — reads now playing" />
    <Button android:id="@+id/btnOverlay" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="2. Draw over other apps — the live layer" />
    <Button android:id="@+id/btnMic" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="3. Microphone — lets Android share the audio wave" />
    <Button android:id="@+id/btnAccess" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="4. Accessibility — knows when you're on home" />
    <Button android:id="@+id/btnFiles" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="5. All files access — lets it read your wallpaper" />
    <Button android:id="@+id/btnCalibrate" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="6. Line the live layer up with the widget" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:text="Style" android:textSize="18sp" android:textColor="#FFD08A" />
    <Switch android:id="@+id/swViz" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Live layer on (wave + inverted text)" />
    <Switch android:id="@+id/swInvert" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Inverted-wallpaper text" />
    <Switch android:id="@+id/swGhost" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Ghost text (outline only)" />
    <Switch android:id="@+id/swShadow" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Warm shadow" />
    <Switch android:id="@+id/swArtAccent" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Accent follows album art" />

    <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:textColor="#B3FFE6C2" android:text="" />
</LinearLayout>
</ScrollView>
